# Copy to .env and fill in. .env is never committed.
DB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me
# Free key from https://rawg.io/apidocs
GAME_API_KEY=your-rawg-api-key
# Optional: YouTube Data API v3 key for trailers (falls back to RAWG trailers when empty)
YOUTUBE_API_KEY=
# Host port the app is published on
APP_PORT=80
